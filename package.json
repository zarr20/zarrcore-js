{
  "name": "zarrcore-js",
  "version": "2.2.1",
  "description": "Shared core utilities for modern TypeScript applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zarrcore": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ],
      "cli": [
        "./dist/cli.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "publish:dry": "npm publish --dry-run"
  },
  "keywords": [
    "react",
    "form",
    "validation",
    "hooks",
    "api",
    "router"
  ],
  "author": "Dzarr al ghifari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zarr20/zarrcore-js.git"
  },
  "bugs": {
    "url": "https://github.com/zarr20/zarrcore-js/issues"
  },
  "homepage": "https://github.com/zarr20/zarrcore-js#readme",
  "peerDependencies": {
    "react": ">=18 <20",
    "axios": "^1.14.2"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.6",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  }
}
