{
  "name": "zarrcore-js",
  "version": "2.1.4",
  "description": "Shared core utilities for modern TypeScript applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "zarrcore": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./form": {
      "import": "./dist/form.js",
      "types": "./dist/form.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./router": {
      "import": "./dist/router.js",
      "types": "./dist/router.d.ts"
    }
  },
  "scripts": {
    "test": "node dist/cli.js --help"
  },
  "keywords": [
    "react",
    "form",
    "validation",
    "hooks",
    "api",
    "router"
  ],
  "author": "Dzarr al ghifari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zarr20/zarrcore-js.git"
  },
  "bugs": {
    "url": "https://github.com/zarr20/zarrcore-js/issues"
  },
  "homepage": "https://github.com/zarr20/zarrcore-js#readme"
}
