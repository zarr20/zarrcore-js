{
  "name": "zarrcore-js",
  "version": "2.2.0",
  "description": "Shared core utilities for modern TypeScript applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "zarrcore": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./form": {
      "import": "./dist/form.js",
      "types": "./dist/form.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./router": {
      "import": "./dist/router.js",
      "types": "./dist/router.d.ts"
    }
  },
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepublishOnly": "npm test",
    "publish:dry": "npm publish --dry-run"
  },
  "keywords": [
    "react",
    "form",
    "validation",
    "hooks",
    "api",
    "router"
  ],
  "author": "Dzarr al ghifari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zarr20/zarrcore-js.git"
  },
  "bugs": {
    "url": "https://github.com/zarr20/zarrcore-js/issues"
  },
  "homepage": "https://github.com/zarr20/zarrcore-js#readme",
  "devDependencies": {
    "@vitest/ui": "^4.1.6",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  }
}
